{
  "name": "@molstar/json-cif-extension",
  "version": "6.0.0-dev.0",
  "type": "module",
  "description": "Mol* json-cif-extension",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./encoder": {
      "molstar-src": "./src/encoder.ts",
      "types": "./lib/encoder.d.ts",
      "import": "./lib/encoder.js"
    },
    "./ligand-graph": {
      "molstar-src": "./src/ligand-graph.ts",
      "types": "./lib/ligand-graph.d.ts",
      "import": "./lib/ligand-graph.js"
    },
    "./model": {
      "molstar-src": "./src/model.ts",
      "types": "./lib/model.d.ts",
      "import": "./lib/model.js"
    },
    "./parser": {
      "molstar-src": "./src/parser.ts",
      "types": "./lib/parser.d.ts",
      "import": "./lib/parser.js"
    },
    "./transformers": {
      "molstar-src": "./src/transformers.ts",
      "types": "./lib/transformers.d.ts",
      "import": "./lib/transformers.js"
    },
    "./utils": {
      "molstar-src": "./src/utils.ts",
      "types": "./lib/utils.d.ts",
      "import": "./lib/utils.js"
    }
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "tslib": "catalog:",
    "@molstar/core": "workspace:*",
    "@molstar/io": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/plugin": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:"
  }
}
