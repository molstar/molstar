{
  "name": "@molstar/anvil-extension",
  "version": "6.0.0-dev.0",
  "type": "module",
  "description": "Mol* anvil-extension",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./algorithm": {
      "molstar-src": "./src/algorithm.ts",
      "types": "./lib/algorithm.d.ts",
      "import": "./lib/algorithm.js"
    },
    "./behavior": {
      "molstar-src": "./src/behavior.ts",
      "types": "./lib/behavior.d.ts",
      "import": "./lib/behavior.js"
    },
    "./prop": {
      "molstar-src": "./src/prop.ts",
      "types": "./lib/prop.d.ts",
      "import": "./lib/prop.js"
    },
    "./representation": {
      "molstar-src": "./src/representation.ts",
      "types": "./lib/representation.d.ts",
      "import": "./lib/representation.js"
    }
  },
  "files": [
    "lib",
    "src",
    "!**/_spec/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "tslib": "catalog:",
    "@molstar/model": "workspace:*",
    "@molstar/core": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/graphics": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:"
  }
}
