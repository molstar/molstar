{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "maxSize": 5242880,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/build",
      "!!**/lib",
      "!!deploy",
      "!!docs/site",
      "!build.mjs",
      "!.v6/baselines",
      "!**/package-lock.json",
      "!**/npm-shrinkwrap.json",
      "!**/_generated/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf",
    "bracketSpacing": true,
    "bracketSameLine": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnsafeFinally": "warn"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "useConst": "error",
        "useThrowOnlyError": "error"
      },
      "suspicious": {
        "noConstantBinaryExpressions": "error",
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": true
          }
        },
        "noSelfCompare": "warn",
        "noVar": "error",
        "useNamespaceKeyword": "warn"
      },
      "nursery": {
        "noExtendNative": "warn",
        "noImpliedEval": "error"
      }
    },
    "includes": ["**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}"]
  },
  "overrides": [
    {
      "includes": ["**/*.stories.ts", "**/*.stories.tsx", "**/.storybook/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ai/agent/src/**", "!packages/ai/agent/src/**/_test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "molstar",
                      "molstar/**",
                      "@molstar/*",
                      "@molstar/*/**",
                      "!@molstar/ai-*",
                      "!@molstar/ai-*/**"
                    ],
                    "message": "The AI packages import nothing of Mol* or Prism: Prism hosts them, not the other way round."
                  },
                  {
                    "group": ["rxjs", "rxjs/**"],
                    "message": "The AI packages use HarnessObservable, not rxjs."
                  },
                  {
                    "group": [
                      "@molstar/ai-harness",
                      "@molstar/ai-harness/**",
                      "@molstar/ai-harness-components",
                      "@molstar/ai-harness-components/**",
                      "@molstar/ai-model-adapters",
                      "@molstar/ai-model-adapters/**",
                      "@molstar/ai-conformance",
                      "@molstar/ai-conformance/**"
                    ],
                    "message": "The agent package imports nothing from the workspace."
                  },
                  {
                    "group": ["node:*"],
                    "message": "No platform API here: it runs in browsers and Node (runtimes are harness-components)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ai/harness/src/**", "!packages/ai/harness/src/**/_test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "molstar",
                      "molstar/**",
                      "@molstar/*",
                      "@molstar/*/**",
                      "!@molstar/ai-*",
                      "!@molstar/ai-*/**"
                    ],
                    "message": "The AI packages import nothing of Mol* or Prism: Prism hosts them, not the other way round."
                  },
                  {
                    "group": ["rxjs", "rxjs/**"],
                    "message": "The AI packages use HarnessObservable, not rxjs."
                  },
                  {
                    "group": [
                      "@molstar/ai-harness-components",
                      "@molstar/ai-harness-components/**",
                      "@molstar/ai-model-adapters",
                      "@molstar/ai-model-adapters/**",
                      "@molstar/ai-conformance",
                      "@molstar/ai-conformance/**"
                    ],
                    "message": "The harness depends only on the agent package."
                  },
                  {
                    "group": ["node:*"],
                    "message": "No platform API here: it runs in browsers and Node (runtimes are harness-components)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ai/harness-components/src/**", "!packages/ai/harness-components/src/**/_test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "molstar",
                      "molstar/**",
                      "@molstar/*",
                      "@molstar/*/**",
                      "!@molstar/ai-*",
                      "!@molstar/ai-*/**"
                    ],
                    "message": "The AI packages import nothing of Mol* or Prism: Prism hosts them, not the other way round."
                  },
                  {
                    "group": ["rxjs", "rxjs/**"],
                    "message": "The AI packages use HarnessObservable, not rxjs."
                  },
                  {
                    "group": [
                      "@molstar/ai-model-adapters",
                      "@molstar/ai-model-adapters/**",
                      "@molstar/ai-conformance",
                      "@molstar/ai-conformance/**"
                    ],
                    "message": "Components implement the harness's contracts only."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ai/model-adapters/src/**", "!packages/ai/model-adapters/src/**/_test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "molstar",
                      "molstar/**",
                      "@molstar/*",
                      "@molstar/*/**",
                      "!@molstar/ai-*",
                      "!@molstar/ai-*/**"
                    ],
                    "message": "The AI packages import nothing of Mol* or Prism: Prism hosts them, not the other way round."
                  },
                  {
                    "group": ["rxjs", "rxjs/**"],
                    "message": "The AI packages use HarnessObservable, not rxjs."
                  },
                  {
                    "group": [
                      "@molstar/ai-harness",
                      "@molstar/ai-harness/**",
                      "@molstar/ai-harness-components",
                      "@molstar/ai-harness-components/**",
                      "@molstar/ai-conformance",
                      "@molstar/ai-conformance/**"
                    ],
                    "message": "Adapters implement the agent package's port only."
                  },
                  {
                    "group": ["node:*"],
                    "message": "No platform API here: it runs in browsers and Node (runtimes are harness-components)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ai/conformance/src/**", "!packages/ai/conformance/src/**/_test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "molstar",
                      "molstar/**",
                      "@molstar/*",
                      "@molstar/*/**",
                      "!@molstar/ai-*",
                      "!@molstar/ai-*/**"
                    ],
                    "message": "The AI packages import nothing of Mol* or Prism: Prism hosts them, not the other way round."
                  },
                  {
                    "group": ["rxjs", "rxjs/**"],
                    "message": "The AI packages use HarnessObservable, not rxjs."
                  },
                  {
                    "group": [
                      "@molstar/ai-harness-components",
                      "@molstar/ai-harness-components/**",
                      "@molstar/ai-model-adapters",
                      "@molstar/ai-model-adapters/**"
                    ],
                    "message": "The suite tests through the contracts; backends bring their own fixtures."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "quoteProperties": "asNeeded",
      "expand": "auto"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  }
}
