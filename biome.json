{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "maxSize": 5242880,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/build",
      "!!**/lib",
      "!!deploy",
      "!!.claude",
      "!!apps/docs/dist",
      "!!apps/docs/.astro",
      "!build.mjs",
      "!.v6/baselines",
      "!**/package-lock.json",
      "!**/npm-shrinkwrap.json",
      "!**/_generated/**",
      "!packages/sequences/**/_test/**/*.json",
      "!packages/prism/viewer/src/_stories/**/fixtures/**",
      "!packages/prism/viewer/src/**/_test/fixtures/**",
      "!packages/mvs/runtime/src/_test/fixtures/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf",
    "bracketSpacing": true,
    "bracketSameLine": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnsafeFinally": "warn"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "useConst": "error",
        "useThrowOnlyError": "error"
      },
      "suspicious": {
        "noConstantBinaryExpressions": "error",
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": true
          }
        },
        "noSelfCompare": "warn",
        "noVar": "error",
        "useNamespaceKeyword": "warn"
      },
      "nursery": {
        "noExtendNative": "warn",
        "noImpliedEval": "error"
      }
    },
    "includes": ["**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}"]
  },
  "overrides": [
    {
      "includes": [
        "**/*.stories.ts",
        "**/*.stories.tsx",
        "**/.storybook/**",
        "vitest.config.ts",
        "vitest.live.config.ts",
        "packages/sequences/**/vitest*.config.ts",
        "packages/prism/viewer/vitest*.config.ts",
        "packages/prism/ui/vitest*.config.ts",
        "packages/prism/assistant/vitest*.config.ts",
        "packages/ai/vitest*.config.ts",
        "apps/docs/astro.config.ts",
        "examples/minimal-prism-viewer/vite.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}", "!packages/ai/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["zod", "zod/**"],
                    "message": "zod is the AI package's own: declare tool inputs as field shapes (packages/ai/_spec/tools.md §2)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/extensions/command-language/src/language/**",
        "!packages/extensions/command-language/src/language/**/_test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "molstar",
                      "molstar/**",
                      "@molstar/*",
                      "@molstar/*/**",
                      "!@molstar/core",
                      "!@molstar/core/**",
                      "!@molstar/query-language",
                      "!@molstar/query-language/**"
                    ],
                    "message": "The command language is plugin- and UI-free: core and query-language only; the host is in prism-viewer/ (command-language _spec §2)."
                  },
                  {
                    "group": ["rxjs", "rxjs/**", "react", "react/**", "react-dom", "react-dom/**", "zod", "zod/**"],
                    "message": "The command language is plugin- and UI-free (command-language _spec §2)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ai/src/messages/**", "!packages/ai/src/messages/**/_test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "molstar",
                      "molstar/**",
                      "@molstar/*",
                      "@molstar/*/**",
                      "!@molstar/core/data/util/hash-functions"
                    ],
                    "message": "The AI package imports nothing of Mol* or Prism but core's one hash file (packages/ai/_spec/README.md, Decisions): Prism hosts it, not the other way round."
                  },
                  {
                    "group": ["rxjs", "rxjs/**"],
                    "message": "The AI package uses HarnessObservable, not rxjs."
                  },
                  {
                    "group": [
                      "**/harness",
                      "**/harness/**",
                      "**/providers",
                      "**/providers/**",
                      "**/tools",
                      "**/tools/**",
                      "**/session",
                      "**/session/**",
                      "**/trace",
                      "**/trace/**",
                      "**/threads",
                      "**/threads/**",
                      "**/testing",
                      "**/testing/**",
                      "**/narration",
                      "**/narration/**"
                    ],
                    "message": "The messages import nothing of the other folders."
                  },
                  {
                    "group": ["node:*"],
                    "message": "No platform API here: the folders run in browsers and Node."
                  },
                  {
                    "group": ["zod", "zod/**"],
                    "message": "zod is the tools' and the providers' own (packages/ai/_spec/tools.md, Decisions): declare inputs as field shapes."
                  },
                  {
                    "group": ["ai", "ai/**", "@ai-sdk/*", "@ai-sdk/**"],
                    "message": "The AI SDK is the providers' own: the root entry must not pull it."
                  }
                ]
              }
            }
          }
        }
      }
