{
  "name": "@molstar/model",
  "version": "6.0.0-dev.0",
  "type": "module",
  "description": "Mol* model",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./formats/particles/_test/*": null,
    "./formats/structure/_test/*": null,
    "./formats/structure/basic/_test/*": null,
    "./formats/volume/_test/*": null,
    "./formats/volume/shared/_test/*": null,
    "./formats/writer/ccp4/_test/*": null,
    "./model/_test/*": null,
    "./model/particles/_test/*": null,
    "./model/sequence/alignment/_test/*": null,
    "./model/structure/model/_test/*": null,
    "./model/structure/model/properties/utils/_test/*": null,
    "./model/structure/query/queries/_test/*": null,
    "./model/structure/query/utils/_test/*": null,
    "./model/structure/structure/_test/*": null,
    "./model/structure/structure/carbohydrates/_test/*": null,
    "./model/structure/structure/element/_test/*": null,
    "./model/structure/structure/element/schema-selection/_test/*": null,
    "./model/structure/structure/unit/bonds/_test/*": null,
    "./model/structure/structure/util/_test/*": null,
    "./model/volume/_test/*": null,
    "./props/common/_test/*": null,
    "./props/computed/_test/*": null,
    "./props/computed/accessible-surface-area/_test/*": null,
    "./props/computed/chemistry/_test/*": null,
    "./props/computed/interactions/_test/*": null,
    "./props/integrative/_test/*": null,
    "./props/volume/streamlines/_test/*": null,
    "./script/_test/*": null,
    "./script/runtime/query/_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "immutable": "catalog:",
    "tslib": "catalog:",
    "@molstar/core": "workspace:*",
    "@molstar/io": "workspace:*",
    "@molstar/query-language": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:"
  }
}
