{
  "extends": "../../../tsconfig.base.json",
  // The build. Imports Mol* (DOM, WebXR types). Typed arrays everywhere: their index reads are numbers, as in Mol*.
  "compilerOptions": {
    "strict": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "erasableSyntaxOnly": true,
    "rootDir": "src",
    "outDir": "lib",
    "tsBuildInfoFile": "lib/tsconfig.tsbuildinfo",
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "webxr"]
  },
  "include": ["src"],
  "exclude": ["src/**/_test/**", "src/**/_stories/**", "src/**/*.stories.ts", "src/**/*.stories.tsx"],
  "references": [
    { "path": "../core" },
    { "path": "../viewer" },
    { "path": "../../core" },
    { "path": "../../io" },
    { "path": "../../model" },
    { "path": "../../query-language" },
    { "path": "../../plugin/core" },
    { "path": "../../mvs/builder" },
    { "path": "../../mvs/runtime" }
  ]
}
