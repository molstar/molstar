{
  "name": "@molstar/seq-molstar-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Mol* adapter: the molstar:structure complex provider, structure formats and services, Mol* loci to Seq* runs and back.",
  "exports": {
    ".": "./src/index.ts",
    "./viewer": "./src/viewer.ts",
    "./plugin": "./src/plugin.ts",
    "./_stories/*": null,
    "./_test/*": null
  },
  "files": [
    "src",
    "!**/_test/**",
    "!**/_stories/**",
    "!**/*.stories.*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:full": "vitest run && vitest run --config vitest.heap.config.ts",
    "test:heap": "vitest run --config vitest.heap.config.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@molstar/seq-core": "workspace:*",
    "@molstar/seq-viewer": "workspace:*",
    "molstar": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/webxr": "^0.5.24",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
