{
  "extends": "../../../tsconfig.base.json",
  // The query language with the strict index reads (no emit).
  "compilerOptions": {
    "strict": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "erasableSyntaxOnly": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/query", "_test/query"],
  "references": [{ "path": "../../core" }, { "path": "../../io" }]
}
