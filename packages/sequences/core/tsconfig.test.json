{
  "extends": "../../../tsconfig.base.json",
  // _test, bench and scripts (no emit). The scripts are run by Node's type stripping and import with .ts.
  "compilerOptions": {
    "composite": false, "declaration": false, "declarationMap": false, "noEmit": true,
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["_test", "bench", "scripts"],
  "exclude": ["_test/query"]
}
