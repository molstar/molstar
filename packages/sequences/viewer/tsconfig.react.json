{
  "extends": "../../../tsconfig.base.json",
  // The React UI and its tests (no emit); with the DOM lib.
  "compilerOptions": {
    "composite": false, "declaration": false, "declarationMap": false, "noEmit": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/react", "_test/react"]
}
