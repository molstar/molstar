{
  "extends": "../../../tsconfig.base.json",
  // The DOM element and its tests (no emit); with the DOM lib.
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/dom", "_test/dom"]
}
