{
  "extends": "../../../tsconfig.base.json",
  // No DOM types: /draw and /svg touch no DOM global; /canvas, /dom and /react have their own configs (no emit).
  "compilerOptions": {
    "strict": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "erasableSyntaxOnly": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/canvas", "src/dom", "src/react"],
  "references": [{ "path": "../core" }, { "path": "../../core" }, { "path": "../../io" }]
}
