{
  "extends": "../../../tsconfig.base.json",
  // Never built: its content is the stories and their support code (src/_stories), checked here (no emit). Imports Mol* through @molstar/seq-molstar-poc. Its references are the packages it imports, as built `lib` declarations (`tsc -b ../molstar-poc ../nightingale` first: the `typecheck` script); the stories' Storybook types are local (`src/_stories/support/seqstar-story.ts`).
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "webxr", "vite/client"]
  },
  "include": ["src", "vite.ts"],
  "references": [
    { "path": "../core" },
    { "path": "../viewer" },
    { "path": "../nightingale" },
    { "path": "../molstar-poc" },
    { "path": "../../core" },
    { "path": "../../io" }
  ]
}
