{
  "extends": "../../../tsconfig.base.json",
  // _test and bench (no emit).
  "compilerOptions": {
    "strict": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "erasableSyntaxOnly": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    // The element packages' declarations don't resolve under NodeNext: a local stand-in (types/nightingale-element.d.ts).
    "paths": { "@nightingale-elements/*": ["./types/nightingale-element.d.ts"] }
  },
  "include": ["_test", "bench"],
  "references": [{ "path": "../core" }, { "path": "../../core" }, { "path": "../../io" }]
}
