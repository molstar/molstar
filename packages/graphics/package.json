{
  "name": "@molstar/graphics",
  "version": "6.0.0-dev.0",
  "type": "module",
  "description": "Mol* graphics",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./canvas3d/_test/*": null,
    "./canvas3d/passes/_test/*": null,
    "./formats/shape/_test/*": null,
    "./geo/_test/*": null,
    "./geo/geometry/_test/*": null,
    "./geo/geometry/mesh/_test/*": null,
    "./geo/geometry/text/_test/*": null,
    "./geo/geometry/texture-mesh/_test/*": null,
    "./geo/util/_test/*": null,
    "./geo/util/marching-cubes/_test/*": null,
    "./gl/_test/*": null,
    "./gl/compute/marching-cubes/_test/*": null,
    "./props/computed/representations/_test/*": null,
    "./repr/_test/*": null,
    "./repr/particles/representation/_test/*": null,
    "./repr/shape/_test/*": null,
    "./repr/structure/_test/*": null,
    "./repr/structure/visual/util/_test/*": null,
    "./repr/structure/visual/util/polymer/_test/*": null,
    "./repr/volume/_test/*": null,
    "./theme/_test/*": null,
    "./util/_test/*": null,
    "./util/gizmo/_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "rxjs": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:",
    "tslib": "catalog:",
    "@molstar/core": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/io": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:"
  },
  "peerDependencies": {
    "gl": ">=6 <9"
  },
  "peerDependenciesMeta": {
    "gl": {
      "optional": true
    }
  }
}
