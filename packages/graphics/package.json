{
  "name": "@molstar/graphics",
  "version": "6.0.0-dev.0",
  "type": "module",
  "description": "Mol* graphics",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./canvas3d/_test/*": null,
    "./formats/shape/_test/*": null,
    "./geo/geometry/_test/*": null,
    "./gl/_test/*": null,
    "./repr/particles/representation/_test/*": null,
    "./repr/volume/_test/*": null,
    "./repr/_test/*": null,
    "./theme/_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "rxjs": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:",
    "tslib": "catalog:",
    "@molstar/core": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/io": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:"
  },
  "peerDependencies": {
    "gl": ">=6 <9"
  },
  "peerDependenciesMeta": {
    "gl": {
      "optional": true
    }
  }
}
