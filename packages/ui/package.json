{
  "name": "@molstar/ui",
  "version": "6.0.0-dev.0",
  "type": "module",
  "description": "Mol* UI runtime: a JSX DOM runtime on Mol* core's reactive states",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./dom": {
      "molstar-src": "./src/dom/index.ts",
      "types": "./lib/dom/index.d.ts",
      "import": "./lib/dom/index.js"
    },
    "./react": {
      "molstar-src": "./src/react/index.ts",
      "types": "./lib/react/index.d.ts",
      "import": "./lib/react/index.js"
    },
    "./styles/foundations.css": "./src/styles/foundations.css",
    "./_stories/*": null,
    "./_test/*": null,
    "./commands/_test/*": null,
    "./components/action-footer/_test/*": null,
    "./components/button/_test/*": null,
    "./components/choices/_test/*": null,
    "./components/color/_test/*": null,
    "./components/command-menu/_test/*": null,
    "./components/context-menu/_test/*": null,
    "./components/expandable/_test/*": null,
    "./components/histogram/_test/*": null,
    "./components/icon/_test/*": null,
    "./components/iso-level/_test/*": null,
    "./components/markdown/_test/*": null,
    "./components/params/_test/*": null,
    "./components/popover/_test/*": null,
    "./components/reorder/_test/*": null,
    "./components/scroll-area/_test/*": null,
    "./components/segmented/_test/*": null,
    "./components/select/_test/*": null,
    "./components/skeleton/_test/*": null,
    "./components/text-input/_test/*": null,
    "./components/toolbar/_test/*": null,
    "./components/tooltip/_test/*": null,
    "./components/transfer-function/_test/*": null,
    "./components/virtual-list/_test/*": null,
    "./dom/_test/*": null,
    "./elements/_test/*": null,
    "./forms/_test/*": null,
    "./react/_test/*": null,
    "./shell/_test/*": null,
    "./styles/_test/*": null,
    "./testing/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/_spec/**",
    "!**/_stories/**",
    "!**/testing/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json",
    "styles": "node scripts/css.mjs",
    "styles:check": "node scripts/css.mjs --check",
    "styles:watch": "node scripts/css.mjs --watch",
    "icons": "node scripts/icons.mjs",
    "icons:check": "node scripts/icons.mjs --check"
  },
  "dependencies": {
    "tslib": "catalog:",
    "@molstar/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:",
    "@molstar/test-harness": "workspace:*",
    "vitest": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/web-components-vite": "catalog:",
    "lightningcss": "catalog:",
    "lucide-static": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "preact": "catalog:",
    "axe-core": "catalog:"
  }
}
