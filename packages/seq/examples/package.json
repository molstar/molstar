{
  "name": "@molstar/seqx-examples",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Seq* (next): the example datasets' fixtures and one builder module per view",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@molstar/core": "workspace:*",
    "@molstar/seqx-core": "workspace:*",
    "@molstar/seqx-ext-rondo": "workspace:*",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@molstar/io": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
