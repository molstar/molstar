{
  "name": "@molstar/seqx-core",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Seq* (next): the SeqViewSpec language, the coordinate model, the source protocol and the pure passes from a spec to draw lists",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./lang": {
      "molstar-src": "./src/lang/index.ts",
      "types": "./lib/lang/index.d.ts",
      "import": "./lib/lang/index.js"
    },
    "./query": {
      "molstar-src": "./src/query/index.ts",
      "types": "./lib/query/index.d.ts",
      "import": "./lib/query/index.js"
    },
    "./data": {
      "molstar-src": "./src/data/index.ts",
      "types": "./lib/data/index.d.ts",
      "import": "./lib/data/index.js"
    },
    "./_test/*": null,
    "./lang/_test/*": null,
    "./query/_test/*": null,
    "./data/_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@molstar/core": "workspace:*",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
