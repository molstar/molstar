{
  "name": "@molstar/ai-agent",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* AI: The model side's shapes: messages and their parts, tool definitions, model configuration, the ModelAdapter port, hashMessage and digest",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@molstar/core": "workspace:*",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
