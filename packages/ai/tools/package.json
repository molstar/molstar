{
  "name": "@molstar/ai-tools",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* AI: Tools for the harness: a tool, its input (field shapes or zod), its result for the model, bindings, repeated reads, nested tools, schedules, tool groups (skills) and their disclosure",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./zod": {
      "molstar-src": "./src/zod.ts",
      "types": "./lib/zod.d.ts",
      "import": "./lib/zod.js"
    },
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@molstar/ai-agent": "workspace:*",
    "@molstar/ai-harness": "workspace:*",
    "zod": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@molstar/ai-components": "workspace:*",
    "@molstar/ai-conformance": "workspace:*"
  }
}
