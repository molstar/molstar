{
  "name": "@molstar/ai-narration",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* AI: narration voiced: text-to-speech providers behind one port (Gemini, OpenAI), and the audio encoded behind another (WAV built in; Mediabunny with the browser's own AAC and Opus encoders at ./mediabunny)",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./mediabunny": {
      "molstar-src": "./src/mediabunny.ts",
      "types": "./lib/mediabunny.d.ts",
      "import": "./lib/mediabunny.js"
    },
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "mediabunny": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
