{
  "name": "@molstar/ai-trace",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* AI: The agent trace: a projection of the harness records (turns, steps, attempts, what each model call saw, prefix breaks, usage) as data for a trace view",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@molstar/ai-agent": "workspace:*",
    "@molstar/ai-harness": "workspace:*",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@molstar/ai-components": "workspace:*",
    "@molstar/ai-conformance": "workspace:*"
  }
}
