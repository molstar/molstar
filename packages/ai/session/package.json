{
  "name": "@molstar/ai-session",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* AI: An agent session over the harness: turns, resume, stop; the default drive (approval, schedules, retries, budgets, repair); message composition; compaction (./compaction)",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./compaction": {
      "molstar-src": "./src/compaction/index.ts",
      "types": "./lib/compaction/index.d.ts",
      "import": "./lib/compaction/index.js"
    },
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@molstar/ai-agent": "workspace:*",
    "@molstar/ai-harness": "workspace:*",
    "@molstar/ai-tools": "workspace:*",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@molstar/ai-conformance": "workspace:*"
  }
}
