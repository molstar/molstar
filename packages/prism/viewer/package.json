{
  "name": "@molstar/prism-viewer",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* Prism: the viewer mode (Mol*'s own UI: the scene and state trees, structure tools, snapshots, export); opt-in",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./features/*": {
      "molstar-src": "./src/features/*/index.ts",
      "types": "./lib/features/*/index.d.ts",
      "import": "./lib/features/*/index.js"
    },
    "./_stories/*": null,
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/_stories/**",
    "!**/*.stories.*",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json",
    "styles": "node ../ui/scripts/css.mjs --root . --prefix viewer",
    "styles:check": "node ../ui/scripts/css.mjs --root . --prefix viewer --check"
  },
  "dependencies": {
    "@molstar/ai-agent": "workspace:*",
    "@molstar/ai-components": "workspace:*",
    "@molstar/ai-fibers": "workspace:*",
    "@molstar/ai-harness": "workspace:*",
    "@molstar/ai-session": "workspace:*",
    "@molstar/ai-tools": "workspace:*",
    "@molstar/core": "workspace:*",
    "@molstar/graphics": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/mvs": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/plugin-headless": "workspace:*",
    "@molstar/prism-ui": "workspace:*",
    "@molstar/query-language": "workspace:*",
    "@molstar/seq-core": "workspace:*",
    "@molstar/seq-molstar-poc": "workspace:*",
    "@molstar/seq-viewer": "workspace:*",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@molstar/ai-conformance": "workspace:*",
    "@molstar/ai-model-adapters": "workspace:*",
    "@storybook/web-components-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:",
    "typescript": "catalog:"
  }
}
