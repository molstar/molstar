      "import": "./lib/api/annotations.js"
    },
    "./commands/operations": {
      "molstar-src": "./src/commands/operations.ts",
      "types": "./lib/commands/operations.d.ts",
      "import": "./lib/commands/operations.js"
    },
    "./ui/download": {
      "molstar-src": "./src/ui/download.ts",
      "types": "./lib/ui/download.d.ts",
      "import": "./lib/ui/download.js"
    },
    "./storage/model": {
      "molstar-src": "./src/storage/model.ts",
      "types": "./lib/storage/model.d.ts",
      "import": "./lib/storage/model.js"
    },
    "./sources/watched": {
      "molstar-src": "./src/sources/watched.ts",
      "types": "./lib/sources/watched.d.ts",
      "import": "./lib/sources/watched.js"
    },
