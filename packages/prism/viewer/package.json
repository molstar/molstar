      "import": "./lib/viewer.js"
    },
    "./spec": {
      "molstar-src": "./src/spec.ts",
      "types": "./lib/spec.d.ts",
      "import": "./lib/spec.js"
    },
    "./default-spec": {
      "molstar-src": "./src/default-spec.ts",
      "types": "./lib/default-spec.d.ts",
      "import": "./lib/default-spec.js"
    },
