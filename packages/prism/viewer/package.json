      "molstar-src": "./src/agent/skills.ts",
      "types": "./lib/agent/skills.d.ts",
      "import": "./lib/agent/skills.js"
    },
    "./features/*": {
      "molstar-src": "./src/features/*/index.ts",
      "types": "./lib/features/*/index.d.ts",
      "import": "./lib/features/*/index.js"
    },
    "./views/structure/scene-row": {
      "molstar-src": "./src/views/structure/scene-row.tsx",
      "types": "./lib/views/structure/scene-row.d.ts",
      "import": "./lib/views/structure/scene-row.js"
    },
    "./_stories/*": null,
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/_stories/**",
    "!**/*.stories.*",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:heap": "vitest run --config vitest.heap.config.ts",
    "test:scaling": "vitest run --config vitest.scaling.config.ts",
    "styles": "node ../ui/scripts/css.mjs --root . --prefix viewer",
    "styles:check": "node ../ui/scripts/css.mjs --root . --prefix viewer --check"
  },
  "dependencies": {
    "@molstar/ai": "workspace:*",
    "@molstar/core": "workspace:*",
    "@molstar/graphics": "workspace:*",
    "@molstar/io": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/mvs": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/prism-ui": "workspace:*",
    "@molstar/query-language": "workspace:*",
    "@molstar/seq-core": "workspace:*",
    "@molstar/seq-viewer": "workspace:*",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@storybook/web-components-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:",
    "fake-indexeddb": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
