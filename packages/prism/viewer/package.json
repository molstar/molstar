    },
    "./testing/real-viewer": {
      "molstar-src": "./src/testing/real-viewer.ts",
      "types": "./lib/testing/real-viewer.d.ts",
      "import": "./lib/testing/real-viewer.js"
    },
    "./agent/account": {
      "molstar-src": "./src/agent/account.ts",
      "types": "./lib/agent/account.d.ts",
