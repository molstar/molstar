      "types": "./lib/options.d.ts",
      "import": "./lib/options.js"
    },
    "./element": {
      "molstar-src": "./src/element.ts",
      "types": "./lib/element.d.ts",
      "import": "./lib/element.js"
    },
    "./api": {
      "molstar-src": "./src/api.ts",
