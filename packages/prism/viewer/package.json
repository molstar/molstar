{
  "name": "@molstar/prism-viewer",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* Prism: the viewer mode (Mol*'s own UI: the scene and state trees, structure tools, snapshots, export); opt-in",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./page": {
      "molstar-src": "./src/page.ts",
      "types": "./lib/page.d.ts",
      "import": "./lib/page.js"
    },
    "./headless": {
