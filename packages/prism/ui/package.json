{
  "name": "@molstar/prism-ui",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* Prism UI",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./_stories/*": null,
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/_stories/**",
    "!**/*.stories.*",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json",
    "styles": "node scripts/css.mjs",
    "styles:check": "node scripts/css.mjs --check",
    "styles:watch": "node scripts/css.mjs --watch",
    "icons": "node scripts/icons.mjs",
    "icons:check": "node scripts/icons.mjs --check"
  },
  "dependencies": {
    "@molstar/core": "workspace:*",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/web-components-vite": "catalog:",
    "@types/react": "catalog:",
    "lit": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "lightningcss": "catalog:",
    "lucide-static": "catalog:",
    "preact": "catalog:"
  }
}
