{
  "name": "@molstar/io",
  "version": "6.0.0-dev.0",
  "type": "module",
  "description": "Mol* io",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./common/_test/*": null,
    "./common/binary-cif/_test/*": null,
    "./reader/_test/*": null,
    "./reader/cif/binary/_test/*": null,
    "./writer/_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@types/node": "catalog:",
    "tslib": "catalog:",
    "@molstar/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:"
  }
}
