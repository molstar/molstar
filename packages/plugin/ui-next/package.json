{
  "name": "@molstar/plugin-ui-next",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* plugin-ui-next",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./_stories/*": null,
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/_stories/**",
    "!**/*.stories.*",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "styles": "node scripts/css.mjs",
    "styles:check": "node scripts/css.mjs --check",
    "styles:watch": "node scripts/css.mjs --watch"
  },
  "dependencies": {
    "@molstar/core": "workspace:*",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/web-components-vite": "catalog:",
    "@types/react": "catalog:",
    "lit": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "vite": "catalog:",
    "lightningcss": "catalog:"
  }
}
