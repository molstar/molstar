{
  "name": "@molstar/test-harness",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* test harness: the allocation, heap, scaling and timing guards the packages' opt-in tiers share",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./vitest": {
      "types": "./src/vitest.d.mts",
      "default": "./src/vitest.mjs"
    },
    "./*": {
      "molstar-src": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "tslib": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
