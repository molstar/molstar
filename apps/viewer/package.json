{
  "name": "@molstar/viewer",
  "version": "6.0.0-dev.0",
  "type": "module",
  "description": "Mol* viewer",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    ".": {
      "molstar-src": "./src/app.ts",
      "types": "./lib/app.d.ts",
      "import": "./lib/app.js"
    }
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "build",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "node ../../scripts/esbuild/app.mjs apps/viewer --prd",
    "typecheck": "tsc -b",
    "dev": "node ../../scripts/esbuild/app.mjs apps/viewer --dev"
  },
  "dependencies": {
    "tslib": "catalog:",
    "@molstar/mvs": "workspace:*",
    "@molstar/plugin-extension": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/plugin-ui": "workspace:*",
    "@molstar/core": "workspace:*",
    "@molstar/anvil-extension": "workspace:*",
    "@molstar/assembly-symmetry-extension": "workspace:*",
    "@molstar/backgrounds-extension": "workspace:*",
    "@molstar/debug-helpers-extension": "workspace:*",
    "@molstar/dnatco-extension": "workspace:*",
    "@molstar/g3d-extension": "workspace:*",
    "@molstar/geo-export-extension": "workspace:*",
    "@molstar/model-archive-extension": "workspace:*",
    "@molstar/model-export-extension": "workspace:*",
    "@molstar/mp4-export-extension": "workspace:*",
    "@molstar/pdbe-extension": "workspace:*",
    "@molstar/rcsb-extension": "workspace:*",
    "@molstar/sb-ncbr-extension": "workspace:*",
    "@molstar/wwpdb-extension": "workspace:*",
    "@molstar/zenodo-extension": "workspace:*",
    "@molstar/mvs-builder": "workspace:*",
    "@molstar/kinemage-extension": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:"
  },
  "molstar": {
    "entry": "src/index.ts",
    "filename": "molstar.js",
    "globalName": "molstar",
    "themes": [
      "light",
      "dark",
      "blue"
    ]
  }
}
