{
  "name": "@molstar/docking-viewer",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* docking-viewer",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./index": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./viewport": {
      "molstar-src": "./src/viewport.tsx",
      "types": "./lib/viewport.d.ts",
      "import": "./lib/viewport.js"
    }
  },
  "files": [
    "lib",
    "src",
    "!**/_spec/**"
  ],
  "scripts": {
    "build": "node ../../scripts/esbuild/app.mjs apps/docking-viewer --prd",
    "typecheck": "tsc -b",
    "dev": "node ../../scripts/esbuild/app.mjs apps/docking-viewer --dev"
  },
  "dependencies": {
    "tslib": "catalog:",
    "@molstar/model": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/plugin-ui": "workspace:*",
    "@molstar/core": "workspace:*",
    "@molstar/graphics": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:"
  },
  "molstar": {
    "entry": "src/index.ts",
    "filename": "molstar.js",
    "globalName": "molstar"
  }
}
