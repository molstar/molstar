{
  "name": "@molstar/mvs-render-cli",
  "version": "6.0.0-dev.0",
  "type": "module",
  "description": "Mol* mvs-render-cli",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./mvs-mvsj-to-mvsx": {
      "molstar-src": "./src/mvs-mvsj-to-mvsx.ts",
      "types": "./lib/mvs-mvsj-to-mvsx.d.ts",
      "import": "./lib/mvs-mvsj-to-mvsx.js"
    },
    "./mvs-render": {
      "molstar-src": "./src/mvs-render.ts",
      "types": "./lib/mvs-render.d.ts",
      "import": "./lib/mvs-render.js"
    }
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "argparse": "catalog:",
    "jpeg-js": "catalog:",
    "pngjs": "catalog:",
    "tslib": "catalog:",
    "@types/argparse": "catalog:",
    "@types/pngjs": "catalog:",
    "@molstar/mvs-builder": "workspace:*",
    "@molstar/core": "workspace:*",
    "@molstar/graphics": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/mp4-export-extension": "workspace:*",
    "@molstar/plugin-headless": "workspace:*",
    "@molstar/mvs": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:"
  },
  "bin": {
    "mvs-render": "./lib/mvs-render.js"
  },
  "peerDependencies": {
    "gl": ">=6 <9",
    "canvas": "^2.11.2"
  },
  "peerDependenciesMeta": {
    "gl": {
      "optional": true
    },
    "canvas": {
      "optional": true
    }
  }
}
