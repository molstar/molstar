{
  "name": "@molstar/basic-wrapper-example",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* basic-wrapper-example",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./controls": {
      "molstar-src": "./src/controls.tsx",
      "types": "./lib/controls.d.ts",
      "import": "./lib/controls.js"
    },
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**"
  ],
  "scripts": {
    "build": "node ../../scripts/esbuild/app.mjs examples/basic-wrapper --prd",
    "typecheck": "tsc -b",
    "dev": "node ../../scripts/esbuild/app.mjs examples/basic-wrapper --dev"
  },
  "dependencies": {
    "tslib": "catalog:",
    "@molstar/plugin": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/core": "workspace:*",
    "@molstar/plugin-ui": "workspace:*",
    "@molstar/graphics": "workspace:*",
    "@molstar/pdbe-extension": "workspace:*",
    "@molstar/query-language": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:"
  },
  "molstar": {
    "entry": "src/index.ts",
    "filename": "index.js",
    "globalName": "molstar"
  }
}
