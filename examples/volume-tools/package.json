{
  "name": "@molstar/volume-tools-example",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* volume-tools-example",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./controller": {
      "molstar-src": "./src/controller.ts",
      "types": "./lib/controller.d.ts",
      "import": "./lib/controller.js"
    },
    "./index": {
      "molstar-src": "./src/index.tsx",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    ".": {
      "molstar-src": "./src/index.tsx",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./ui/bodies-panel": {
      "molstar-src": "./src/ui/bodies-panel.tsx",
      "types": "./lib/ui/bodies-panel.d.ts",
      "import": "./lib/ui/bodies-panel.js"
    },
    "./ui/drawing-canvas": {
      "molstar-src": "./src/ui/drawing-canvas.tsx",
      "types": "./lib/ui/drawing-canvas.d.ts",
      "import": "./lib/ui/drawing-canvas.js"
    },
    "./ui/mask-panel": {
      "molstar-src": "./src/ui/mask-panel.tsx",
      "types": "./lib/ui/mask-panel.d.ts",
      "import": "./lib/ui/mask-panel.js"
    },
    "./ui/panel-styles": {
      "molstar-src": "./src/ui/panel-styles.tsx",
      "types": "./lib/ui/panel-styles.d.ts",
      "import": "./lib/ui/panel-styles.js"
    }
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**"
  ],
  "scripts": {
    "build": "node ../../scripts/esbuild/app.mjs examples/volume-tools --prd",
    "typecheck": "tsc -b",
    "dev": "node ../../scripts/esbuild/app.mjs examples/volume-tools --dev"
  },
  "dependencies": {
    "rxjs": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tslib": "catalog:",
    "@molstar/core": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/volume-tools-extension": "workspace:*",
    "@molstar/plugin-ui": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": ">=16.14.0",
    "react-dom": ">=16.14.0"
  },
  "peerDependenciesMeta": {},
  "molstar": {
    "entry": "src/index.tsx",
    "filename": "index.js",
    "globalName": "molstar"
  }
}
