{
  "name": "@molstar/plugin-state-server",
  "version": "6.0.0-dev.0",
  "type": "module",
  "description": "Mol* plugin-state-server",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "bin",
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "argparse": "catalog:",
    "express": "catalog:",
    "compression": "catalog:",
    "cors": "catalog:",
    "tslib": "catalog:",
    "@types/argparse": "catalog:",
    "@types/express": "catalog:",
    "@types/cors": "catalog:",
    "@types/compression": "catalog:",
    "@molstar/common-server": "workspace:*",
    "@molstar/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:"
  },
  "bin": {
    "plugin-state": "./bin/plugin-state.mjs"
  }
}
