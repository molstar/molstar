{
  "name": "@molstar/workspace",
  "description": "A comprehensive macromolecular library.",
  "homepage": "https://github.com/molstar/molstar#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/molstar/molstar.git"
  },
  "bugs": {
    "url": "https://github.com/molstar/molstar/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "biome lint .",
    "jest": "jest --runInBand",
    "test": "pnpm lint && pnpm jest",
    "build:lib": "node scripts/workspace/version.mjs --write && tsc -b && node scripts/workspace/assets.mjs",
    "build:apps": "node scripts/esbuild/app.mjs --all --prd",
    "build:distribution": "node scripts/distribution.mjs",
    "build": "pnpm build:lib && pnpm build:apps && pnpm build:distribution",
    "build:workspace": "pnpm build",
    "pack:workspace": "node scripts/workspace/pack.mjs",
    "check:workspace": "node --test scripts/workspace/_test/*.test.mjs && node scripts/workspace/check.mjs",
    "version:check": "node scripts/workspace/version.mjs --check",
    "version:sync": "node scripts/workspace/version.mjs --write",
    "dev:apps": "node scripts/esbuild/app.mjs --dev --kind app",
    "dev:examples": "node scripts/esbuild/app.mjs --dev --kind example",
    "dev": "node scripts/esbuild/app.mjs --all --dev",
    "native:install": "node scripts/native.mjs install",
    "native:run": "node scripts/native.mjs run",
    "test:native": "node scripts/native.mjs test",
    "check:types:full": "node scripts/workspace/typecheck-full.mjs",
    "check:publish": "pnpm test && pnpm build && pnpm check:types:full && pnpm check:workspace && pnpm version:check && pnpm pack:workspace && node smoke/run.mjs node && node smoke/run.mjs types && node smoke/run.mjs source && node smoke/run.mjs cli",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "nodemonConfig": {
    "ignoreRoot": [
      "./node_modules",
      ".git"
    ],
    "ignore": [],
    "delay": 2500
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "\\.ts$": [
        "esbuild-jest-transform",
        {
          "tsconfigRaw": "{\"compilerOptions\":{\"useDefineForClassFields\":false}}"
        }
      ]
    },
    "moduleDirectories": [
      "node_modules"
    ],
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testRegex": "\\.test\\.ts$",
    "moduleNameMapper": {
      "^@molstar/docking-viewer$": "<rootDir>/apps/docking-viewer/src/index.ts",
      "^@molstar/docking-viewer/(.*)$": "<rootDir>/apps/docking-viewer/src/$1",
      "^@molstar/mesoscale-explorer$": "<rootDir>/apps/mesoscale-explorer/src/index.ts",
      "^@molstar/mesoscale-explorer/(.*)$": "<rootDir>/apps/mesoscale-explorer/src/$1",
