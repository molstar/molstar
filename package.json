{
  "name": "@molstar/workspace",
  "description": "A comprehensive macromolecular library.",
  "homepage": "https://github.com/molstar/molstar#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/molstar/molstar.git"
  },
  "bugs": {
    "url": "https://github.com/molstar/molstar/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "biome lint . && node scripts/workspace/test-exports.mjs && node scripts/workspace/export-star-cycles.mjs",
    "test:unit": "vitest run",
    "test:medium": "vitest run --mode medium",
    "test:heavy": "vitest run --mode heavy",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "test": "pnpm lint && pnpm test:unit",
    "build:lib": "node scripts/workspace/version.mjs --write && tsc -b && node scripts/workspace/assets.mjs",
    "build:apps": "node scripts/esbuild/app.mjs --all --prd",
    "build:distribution": "node scripts/distribution.mjs",
    "build": "pnpm build:lib && pnpm build:apps && pnpm build:distribution",
    "build:workspace": "pnpm build",
    "clean": "node scripts/clean.js --all",
    "clean:build": "node scripts/clean.js --build",
    "clean:lib": "node scripts/clean.js --lib",
    "rebuild": "pnpm clean && pnpm build",
    "deploy:local": "pnpm build && node scripts/deploy.js --local",
    "deploy:remote": "pnpm build && node scripts/deploy.js",
    "pack:workspace": "node scripts/workspace/pack.mjs",
    "check:workspace": "node scripts/workspace/check.mjs && node scripts/workspace/slim-bundle.mjs && node scripts/workspace/registry-compare.mjs && node scripts/workspace/composition-check.mjs && node scripts/workspace/query-language-check.mjs",
    "version:check": "node scripts/workspace/version.mjs --check",
    "version:sync": "node scripts/workspace/version.mjs --write",
    "dev:apps": "node scripts/esbuild/app.mjs --dev --kind app",
    "dev:examples": "node scripts/esbuild/app.mjs --dev --kind example",
    "dev:visual-tests": "node scripts/esbuild/visual-tests.mjs",
    "dev": "node scripts/esbuild/app.mjs --all --dev",
    "native:install": "node scripts/native.mjs install",
    "native:run": "node scripts/native.mjs run",
    "test:native": "node scripts/native.mjs test",
    "test:viewer-smoke": "node scripts/viewer-smoke.mjs",
    "check:backend-bundles": "node scripts/check-backend-bundles.mjs",
    "test:visual": "node scripts/visual-tests.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "check:types:full": "node scripts/workspace/typecheck-full.mjs",
    "check:publish": "pnpm format:check && pnpm test && pnpm test:medium && pnpm rebuild && pnpm check:types:full && pnpm check:workspace && pnpm version:check && pnpm pack:workspace && node smoke/run.mjs node && node smoke/run.mjs types && node smoke/run.mjs source && node smoke/run.mjs cli",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write . && prettier --write \"**/*.{md,mdx,yaml,yml,scss}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,mdx,yaml,yml,scss}\""
  },
  "nodemonConfig": {
    "ignoreRoot": [
      "./node_modules",
      ".git"
    ],
    "ignore": [],
    "delay": 2500
  },
